{
  "rule": "capture",
  "about": "The capture line (renderer/src/taskparse.js, the core's capture.rs, NexusCore CaptureParse.swift). Each case: the line typed, and what it means as {title, ...facts, subs, flags}: facts are due, key, plan (days, 'YYYY-MM-DD' or 'YYYY-MM-DD HH:MM'), est, waiting {on, since}, every {freq, on}, tags (a tag that names a workstream is not one); subs are the subtasks after ';' (a title, or [title, facts]); flags are 'code' or 'code:text'. A command is {kind, text}; nothing typed is {kind: 'empty'}. 'plan' is the day the line was typed on (a day's page), 'workstreamTags' the tags that name a workstream. The answers are the laptop's table (dev/unit-taskparse.mjs), worked out from docs/guide.md's capture words.",
  "today": "2026-10-28",
  "cases": [
    { "text": "physics hw sheet by friday", "expect": { "title": "physics hw sheet", "due": "2026-10-30" } },
    { "text": "phys ia draft on thu 4pm 2h!", "expect": { "title": "phys ia draft", "key": true, "plan": ["2026-10-29 16:00"], "est": "2h" } },
    { "text": "chem lab report by fri; data; graph; conclusion", "expect": { "title": "chem lab report", "due": "2026-10-30", "subs": ["data", "graph", "conclusion"] } },
    { "text": "sat practice test on sat", "expect": { "title": "sat practice test", "plan": ["2026-10-31"], "flags": ["ambiguous:sat"] } },
    { "text": "by fri 5pm submit form", "expect": { "title": "submit form", "due": "2026-10-30", "flags": ["time-dropped:5pm"] } },
    { "text": "\"due friday\" reading", "expect": { "title": "due friday reading" } },
    { "text": "IA draft #summative by fri", "expect": { "title": "IA draft", "due": "2026-10-30", "tags": ["summative"] } },
    { "text": "essay feedback waiting on Mr Daniel", "expect": { "title": "essay feedback", "waiting": { "on": "Mr Daniel", "since": "2026-10-28" } } },
    { "text": "physics quiz every mon", "expect": { "title": "physics quiz", "every": { "freq": "week", "on": "mon" } } },
    { "text": "read ch 4 in 3 days", "expect": { "title": "read ch 4", "due": "2026-10-31" } },
    { "text": "econ p1 12 nov", "today": "2026-12-01", "expect": { "title": "econ p1", "due": "2027-11-12" } },
    { "text": "by fri 2h", "expect": { "title": "", "due": "2026-10-30", "est": "2h", "flags": ["no-title"] } },
    { "text": "/plan my week", "expect": { "kind": "claude", "text": "/plan my week" } },
    { "text": "> settings", "expect": { "kind": "palette", "text": "> settings" } },
    { "text": "   ", "expect": { "kind": "empty" } },
    { "text": "physics hw sheet by fri; q1-5 by thu on wed 45m; q6-10", "expect": { "title": "physics hw sheet", "due": "2026-10-30", "subs": [["q1-5", { "due": "2026-10-29", "plan": ["2026-11-04"], "est": "45m" }], "q6-10"] } },
    { "text": "\"a; b\" notes; c", "expect": { "title": "a; b notes", "subs": ["c"] } },
    { "text": "portfolio next week", "expect": { "title": "portfolio", "due": "2026-11-02" } },
    { "text": "fees by end of month", "expect": { "title": "fees", "due": "2026-10-31" } },
    { "text": "flashcards do today", "expect": { "title": "flashcards", "plan": ["2026-10-28"] } },
    { "text": "visa by 2026-10-01", "expect": { "title": "visa", "due": "2026-10-01", "flags": ["past-date:2026-10-01"] } },
    { "text": "call mum 4:30pm", "expect": { "title": "call mum", "plan": ["2026-10-28 16:30"] } },
    { "text": "physics ia by fri on thu 4pm", "expect": { "title": "physics ia", "due": "2026-10-30", "plan": ["2026-10-29 16:00"] } },
    { "text": "revise 4pm", "plan": "2026-10-30", "expect": { "title": "revise", "plan": ["2026-10-30 16:00"] } },
    { "text": "essay by mon", "plan": "2026-10-28", "expect": { "title": "essay", "due": "2026-11-02", "plan": ["2026-10-28"] } },
    { "text": "read ~1.5h", "expect": { "title": "read", "est": "1h30m" } },
    { "text": "essay ★ by fri", "expect": { "title": "essay", "due": "2026-10-30", "key": true } },
    { "text": "SAT study 1h daily", "expect": { "title": "SAT study", "est": "1h", "every": { "freq": "day" } } },
    { "text": "gym every fri 4pm", "expect": { "title": "gym", "plan": ["2026-10-30 16:00"], "every": { "freq": "week", "on": "fri" } } },
    { "text": "stand-up every weekday", "expect": { "title": "stand-up", "every": { "freq": "weekdays" } } },
    { "text": "waiting on OJSS reply", "expect": { "title": "reply", "waiting": { "on": "OJSS", "since": "2026-10-28" } } },
    { "text": "worksheet #chem #summative", "workstreamTags": ["chem"], "expect": { "title": "worksheet", "tags": ["summative"] } },
    { "text": "may need to redo", "expect": { "title": "may need to redo", "flags": ["ambiguous:may"] } },
    { "text": "take a week off", "expect": { "title": "take a week off" } },
    { "text": "call mum today 4pm", "expect": { "title": "call mum", "due": "2026-10-28", "flags": ["time-dropped:4pm"] } },
    { "text": "Submit form, by fri.", "expect": { "title": "Submit form", "due": "2026-10-30" } }
  ]
}
